+	"runtime"
 	"sort"
 	"strings"
 
@@ -15,9 +17,37 @@ type Address struct {
 	Name    string `json:"name"`
 }
 
+// androidAddresses parses "address/interface,..." passed by the Android host
+// app, which can read the active networks that Go itself cannot enumerate.
+func androidAddresses(value string) []Address {
+	var result []Address
+	seen := map[string]bool{}
+	for _, item := range strings.Split(value, ",") {
+		address, name, _ := strings.Cut(strings.TrimSpace(item), "/")
+		ip := net.ParseIP(address)
+		if ip == nil || ip.To4() == nil || ip.IsLoopback() || ip.IsUnspecified() || seen[ip.String()] {
+			continue
+		}
+		if name == "" {
+			name = "android"
+		}
+		seen[ip.String()] = true
+		result = append(result, Address{Address: ip.String(), Name: name})
+	}
+	sort.Slice(result, func(left, right int) bool { return result[left].Address < result[right].Address })
+	return result
+}
+
 // List describes invitation addresses. It does not choose or constrain the
 // media interfaces, which remain owned by ICE and the operating system.
 func List() ([]Address, error) {
+	if runtime.GOOS == "android" {
+		// Android 11+ denies apps the netlink request behind interface
+		// enumeration; the host app passes the real addresses instead.
+		if listed := androidAddresses(os.Getenv("PIIK_LAN_ADDRESSES")); len(listed) > 0 {
+			return listed, nil
+		}
+	}
 	interfaces, err := anet.Interfaces()
 	if err != nil {
 		return nil, fmt.Errorf("list network interfaces: %w", err)
