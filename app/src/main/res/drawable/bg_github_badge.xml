<?xml version="1.0" encoding="utf-8"?>
<!--
  GitHub 徽标的层叠背景：底层深色偏移块 + 上层渐变面 + 描边，
  形成轻微浮雕/层叠质感，避免图标平贴在页面上。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层：向下偏移 2dp 的深色块，充当投影 -->
    <item android:top="2dp" android:left="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#5A000000" />
        </shape>
    </item>
    <!-- 上层：渐变面板 + 描边 -->
    <item android:bottom="2dp" android:right="1dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <gradient
                android:angle="270"
                android:startColor="#2A2F42"
                android:endColor="#1A1D28"
                android:type="linear" />
            <stroke android:width="1dp" android:color="#3A4056" />
        </shape>
    </item>
</layer-list>
